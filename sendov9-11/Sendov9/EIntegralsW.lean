      = (1/5 : ℝ) * W ^ 5 + (2/7 : ℝ) * Q2 * W ^ 7 + (1/9 : ℝ) * Q2 ^ 2 * W ^ 9 + (1/3 : ℝ) * Q1 * W ^ 6 + (1/4 : ℝ) * Q1 * Q2 * W ^ 8 + (1/7 : ℝ) * Q1 ^ 2 * W ^ 7 := by
  have hexp : ∀ t : ℝ, t ^ 4 * (1 + Q1 * t + Q2 * t ^ 2) ^ 2
      = ∑ i : Fin 9, (![0, 0, 0, 0, (1 : ℝ), (2 : ℝ) * Q1, (2 : ℝ) * Q2 + Q1 ^ 2, (2 : ℝ) * Q1 * Q2, Q2 ^ 2] : Fin 9 → ℝ) i * t ^ (i : ℕ) := by
    intro t
