/-!
# Exact tensor-product Bernstein positivity certificates

The finite, computer-assisted half of Anton Shakov's *Sendov's Conjecture in Degree
Nine* rests on proving that explicit rational polynomials are positive on `[0,1]^2`.
This file banks the certificate engine, once, generically.

## Why there is no division

The usual monomial-to-Bernstein conversion carries a factor `C(i,k) / C(N,k)`, which
would force rational arithmetic -- and kernel `Nat.gcd` is not GMP-accelerated, so
40-digit rationals would be fatal.  But `C(N,i) * C(i,k) = C(N,k) * C(N-k, i-k)`, so
after cancelling the basis's own `C(N,i)` the conversion is just the binomial theorem
for `(U + (1-U))^(N-k)` multiplied by `U^k`.  The Bernstein coefficients are therefore
INTEGER combinations of the input coefficients, and `le_of_int_table` discharges the
coefficient bound by `decide` on GMP-accelerated integer arithmetic.

Verified axiom-free (`[propext, Classical.choice, Quot.sound]`) on
`leanprover/lean4:v4.31.0` + Mathlib v4.31.0.
-/

open Finset

namespace Sendov9.Bernstein

/-- The Bernstein basis is a partition of unity on `[0,1]`. -/
theorem sum_basis (N : ℕ) (U : ℝ) :
    ∑ i ∈ range (N + 1), (N.choose i : ℝ) * (U ^ i * (1 - U) ^ (N - i)) = 1 := by
  calc ∑ i ∈ range (N + 1), (N.choose i : ℝ) * (U ^ i * (1 - U) ^ (N - i))
      = ∑ i ∈ range (N + 1), U ^ i * (1 - U) ^ (N - i) * (N.choose i : ℝ) :=
        sum_congr rfl fun i _ => by ring
    _ = (U + (1 - U)) ^ N := (add_pow U (1 - U) N).symm
    _ = 1 := by norm_num

theorem basis_nonneg {N i : ℕ} {U : ℝ} (h0 : 0 ≤ U) (h1 : U ≤ 1) :
    0 ≤ U ^ i * (1 - U) ^ (N - i) :=
  mul_nonneg (pow_nonneg h0 _) (pow_nonneg (by linarith) _)

theorem le_of_bernstein_coeffs (N M : ℕ) (bhat : ℕ → ℕ → ℝ) (c : ℝ)
    (hb : ∀ i ∈ range (N + 1), ∀ j ∈ range (M + 1),
      c * ((N.choose i : ℝ) * (M.choose j : ℝ)) ≤ bhat i j)
    {U V : ℝ} (hU0 : 0 ≤ U) (hU1 : U ≤ 1) (hV0 : 0 ≤ V) (hV1 : V ≤ 1) :
    c ≤ ∑ i ∈ range (N + 1), ∑ j ∈ range (M + 1),
          bhat i j * ((U ^ i * (1 - U) ^ (N - i)) * (V ^ j * (1 - V) ^ (M - j))) := by
  have hu : ∀ i : ℕ, (0:ℝ) ≤ U ^ i * (1 - U) ^ (N - i) := fun _ => basis_nonneg hU0 hU1
  have hv : ∀ j : ℕ, (0:ℝ) ≤ V ^ j * (1 - V) ^ (M - j) := fun _ => basis_nonneg hV0 hV1
  have expand : c = ∑ i ∈ range (N + 1), ∑ j ∈ range (M + 1),
      c * ((N.choose i : ℝ) * (M.choose j : ℝ))
        * ((U ^ i * (1 - U) ^ (N - i)) * (V ^ j * (1 - V) ^ (M - j))) := by
    have hN := sum_basis N U
    have hM := sum_basis M V
    calc c = c * ((∑ i ∈ range (N + 1), (N.choose i : ℝ) * (U ^ i * (1 - U) ^ (N - i)))
              * (∑ j ∈ range (M + 1), (M.choose j : ℝ) * (V ^ j * (1 - V) ^ (M - j)))) := by
          rw [hN, hM]; ring
      _ = _ := by
          rw [Finset.sum_mul_sum, Finset.mul_sum]
          refine sum_congr rfl fun i _ => ?_
          rw [Finset.mul_sum]
          exact sum_congr rfl fun j _ => by ring
  rw [expand]
  refine sum_le_sum fun i hi => sum_le_sum fun j hj => ?_
  exact mul_le_mul_of_nonneg_right (hb i hi j hj) (mul_nonneg (hu i) (hv j))

/-- Integer-table form: the coefficient hypothesis becomes a pure integer
statement, dischargeable by `decide` (kernel `Nat`/`Int` arithmetic is
GMP-accelerated; no `Nat.gcd` normalisation is involved). -/
theorem le_of_int_table (N M : ℕ) (T : List (List ℤ)) (p q : ℤ) (hq : 0 < q)
    (hb : ∀ i ∈ range (N + 1), ∀ j ∈ range (M + 1),
      p * ((N.choose i : ℤ) * (M.choose j : ℤ)) ≤ q * ((T.getD i []).getD j 0))
    {U V : ℝ} (hU0 : 0 ≤ U) (hU1 : U ≤ 1) (hV0 : 0 ≤ V) (hV1 : V ≤ 1) :
    (p : ℝ) / (q : ℝ) ≤ ∑ i ∈ range (N + 1), ∑ j ∈ range (M + 1),
          ((((T.getD i []).getD j 0 : ℤ) : ℝ))
            * ((U ^ i * (1 - U) ^ (N - i)) * (V ^ j * (1 - V) ^ (M - j))) := by
  have hqR : (0:ℝ) < (q : ℝ) := by exact_mod_cast hq
  refine le_of_bernstein_coeffs N M
    (fun i j => (((T.getD i []).getD j 0 : ℤ) : ℝ)) ((p : ℝ) / (q : ℝ)) ?_ hU0 hU1 hV0 hV1
  intro i hi j hj
  have h := hb i hi j hj
  have hR : (p : ℝ) * (((N.choose i : ℤ) : ℝ) * ((M.choose j : ℤ) : ℝ))
      ≤ (q : ℝ) * (((T.getD i []).getD j 0 : ℤ) : ℝ) := by exact_mod_cast h
  rw [div_mul_eq_mul_div, div_le_iff₀ hqR]
  push_cast at hR ⊢
  linarith

end Sendov9.Bernstein


